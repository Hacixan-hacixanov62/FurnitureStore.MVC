
@model CreateTask

<div class="main-panel">
    <div class="content-wrapper" style="width: 65pc;">
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" style="color: white"/>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control" style="color: white"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
            <div class="form-group">
                <label asp-for="SelectedUsername" class="control-label">Choose Admin</label>
                <select asp-for="SelectedUsername" asp-items="Model.AdminUsers" class="form-control" style="color: white">
                    <option value="" disabled selected>Choose Admin</option>
                </select>
                <span asp-validation-for="SelectedUsername" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-action="Index" class="btn btn-outline-primary mt-3" style="margin-bottom: 1pc;">← Back</a>
</form>
    </div>
</div>

