@model PromoCodeCreate

@{
    ViewData["Title"] = "Promocode";
}

<div class="main-panel">
    <div class="content-wrapper" style="width: 65pc;">
<form asp-action="Create" method="post">
   <div asp-validation-summary="All" class="text-danger"></div> 

    <div class="form-group">
        <label asp-for="Code"></label>
        <input asp-for="Code"  style="color:white" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DiscountPercent"></label>
        <input asp-for="DiscountPercent"  style="color:white" type="number" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="UsageLimit"></label>
        <input asp-for="UsageLimit"  style="color:white" type="number" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-outline-primary mt-3" style="margin-bottom: 1pc;">← Back</a>

</form>
    </div>
</div>
