@model ProductReviewPage
<div id="site-main" class="site-main">
    <div id="main-content" class="main-content">
        <div id="primary" class="content-area">
            <div id="title" class="page-title" style="background-image: url(/assets/img/@Model.Settings.FirstOrDefault(x => x.Key == "ShopBanner")?.Value);">
                <div class="section-container">
                    <div class="content-title-heading">
                        <h1 class="text-title-heading">@Model.ProductName</h1>
                    </div>
                    <div class="breadcrumbs">
                        <a asp-controller="Home" asp-action="Index">Home</a><span class="delimiter"></span>
                        <a asp-controller="Shop" asp-action="Index">Shop</a>
                    </div>
                </div>
            </div>

            <div id="content" class="site-content" role="main">
                <div class="shop-details zoom">
                    <div class="product-top-info">
                        <div class="section-padding">
                            <div class="section-container p-l-r">
                                <div class="row">
                                    <!-- Product Images -->                              
                                    <!-- Product Images Section -->
                                    <div class="product-images col-lg-7 col-md-12 col-12">
                                        <div class="row">
                                            <!-- Thumbnails -->
                                            <div class="col-md-2">
                                                <div class="thumbnail-container">
                                                    <button class="thumbnail-scroll-btn scroll-up" id="scrollUp" disabled>
                                                        <i class="fa fa-chevron-up"></i>
                                                    </button>
                                                    <div class="thumbnail-wrapper">
                                                        <div class="thumbnail-list" id="thumbnailList">
                                                            @foreach (var item in Model.Images)
                                                            {
                                                                <div class="thumbnail-item" data-index="@Model.Images.ToList().IndexOf(item)">
                                                                    <img src="@item.Img" alt="Product Image @(Model.Images.ToList().IndexOf(item) + 1)">
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <button class="thumbnail-scroll-btn scroll-down" id="scrollDown">
                                                        <i class="fa fa-chevron-down"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Main Image -->
                                            <div class="col-md-10">
                                                <div class="main-image-container">
                                                    <div class="main-image-wrapper">
                                                        <img id="mainProductImage" src="@Model.Images.FirstOrDefault(i => i.IsMain)?.Img" alt="Main Product Image">

                                                        <!-- Navigation Arrows -->
                                                        <button class="nav-arrow prev-arrow" id="prevArrow">
                                                            <i class="fa fa-chevron-left"></i>
                                                        </button>
                                                        <button class="nav-arrow next-arrow" id="nextArrow">
                                                            <i class="fa fa-chevron-right"></i>
                                                        </button>

                                                        <!-- Image Counter -->
                                                        <div class="image-counter">
                                                            <span id="currentImageNum">1</span> / <span id="totalImages">@Model.Images.Count</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Product Info -->
                                    <div class="product-info col-lg-5 col-md-12 col-12">
                                        <h1 class="title">@Model.ProductName</h1>
                                            <span class="price"><ins><span>@Model.Price</span></ins></span>
                                        <div class="description">
                                            <p>@Model.Description</p>
                                        </div>

                                                                    
                                            <script>
                                                document.querySelectorAll('.color-swatch').forEach(function (el) {
                                                    el.addEventListener('click', function () {
                                                        const imgUrl = el.getAttribute('data-img');
                                                        const mainImg = document.getElementById('main-product-image');
                                                        if (imgUrl && mainImg) {
                                                            mainImg.src = imgUrl;
                                                        }
                                                    });
                                                });
                                            </script>
         

                                        <!-- Cart Buttons -->
                                        <div class="buttons">                                       
                                            <form id="addToBasketForm">
                                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                                <div class="variations">
                                                    <table cellspacing="0">
                                                        <tbody>
                                                            <tr>
                                                                <td class="label">Color</td>
                                                                <td class="attributes">
                                                                    <ul class="color-swatches">
                                                                        @foreach (var color in Model.ColorList)
                                                                        {
                                                                            <li>
                                                                                <input type="radio" id="color-@color.Id" name="colorId" value="@color.Id" required />
                                                                                <label for="color-@color.Id" style="background-color:@color.Name;" title="@color.Name"></label>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div class="buttons">
                                                    <div class="add-to-cart-wrap">
                                                        <div class="btn-add-cart">
                                                            <button type="submit"
                                                                    class="button product-btn"
                                                                    id="addToCartBtn"
                                                                    disabled>
                                                                Add to cart
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>

                                            <div id="basketMessage" style="margin-top: 10px;"></div>





                                        </div>
                                        <div class="product-meta">
                                            <span class="posted-in">Category: @Model.Category</span>
                                            <span class="tagged-as">Tags: @Model.Tags.FirstOrDefault()</span>
                                        </div>

                                        <div class="social-share">
                                            <a href="#" class="share-facebook"><i class="fa fa-facebook"></i>Facebook</a>
                                            <a href="#" class="share-twitter"><i class="fa fa-twitter"></i>Twitter</a>
                                            <a href="#" class="share-pinterest"><i class="fa fa-pinterest"></i>Pinterest</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reviews Tab -->
                    <div class="product-tabs">
                        <div class="section-padding">
                            <div class="section-container p-l-r">
                                <div class="product-tabs-wrap">
                                    <ul class="nav nav-tabs" role="tablist">
                                        <li class="nav-item">
                                            <a class="nav-link" data-toggle="tab" href="#reviews" role="tab">Reviews (@Model.Reviews.Count)</a>
                                        </li>
                                    </ul>

                                    <div class="tab-content">
                                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                                            <div id="reviews" class="product-reviews">
                                                <div id="comments">
                                                    <h2 class="reviews-title">@Model.Reviews.Count review(s) for <span>@Model.ProductName</span></h2>

                                                    <ol class="comment-list">
                                                        @foreach (var review in Model.Reviews)
                                                        {
                                                            var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                                            <li class="review" data-review-id="@review.Id">
                                                                <div class="content-comment-container">
                                                                    <div class="comment-container">
                                                                        <div class="comment-text">
                                                                            <div class="review-time">@review.CreatedAt.ToString("M/d/yyyy")</div>
                                                                            @if (User.Identity.IsAuthenticated && userId == review.AppUserId)
                                                                            {
                                                                                <button type="button" class="btn btn-link btn-sm edit-review-btn" onclick="toggleEditForm(@review.Id)">
                                                                                    <i class="fa-solid fa-pencil" style="color: #000000;"></i>
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </div>

                                                                    <div class="description">
                                                                        <p class="review-comment-text">@review.Comment</p>
                                                                        <p><i class="fa-regular fa-user"></i> @review.UserName</p>
                                                                    </div>

                                                                    @if (User.Identity.IsAuthenticated && userId == review.AppUserId)
                                                                    {
                                                                      <form asp-action="EditReview" method="post" id="edit-form-@review.Id" style="display:none;"> 
                                                                          <input type="hidden" name="Id" value="@review.Id" /> 
                                                                          <input type="hidden" name="AppUserId" value="@review.AppUserId" />
                                                                          <input type="hidden" name="ProductId" value="@Model.ProductId" /> 
                                                                          <div class="form-group"> 
                                                                              <label>Comment</label>
                                                                              <textarea name="Comment" class="form-control">@review.Comment</textarea> 
                                                                          </div> 
                                                                          <div class="edit-form-buttons"> 
                                                                              @* <button type="submit" class="btn btn-sm">Save</button> *@
                                                                              <input name="submit" type="submit" id="submit" class="button-outline" value="Save">

                                                                                <button type="button" class="btn button-outline btn-sm" onclick="toggleEditForm(@review.Id)">Cancel</button>
                                                                            </div> 
                                                                      </form> 
                                                                        <form method="post" class="delete-review-form" data-review-id="@review.Id" data-product-id="@Model.ProductId">
                                                                            <input type="hidden" name="id" value="@review.Id" />
                                                                            <input type="hidden" name="productId" value="@Model.ProductId" />
                                                                            <button type="submit" style="margin-left: 27pc; ">
                                                                                <i class="fa-solid fa-delete-left fa-sm" style="color: #d21919;"></i>
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                </div>
                                                            </li>
                                                        }
                                                    </ol>

                                                </div>

                                                <!-- Review Form -->
                                                <div id="review-form">
                                                    <div id="respond" class="comment-respond">
                                                        <span id="reply-title" class="comment-reply-title">Add a review</span>
                                                      
                                                        <form id="add-review-form" asp-controller="ProductDetail" asp-action="AddReview" method="post">
                                                            <input type="hidden" name="ProductId" value="@Model.ProductId" />

                                                            <div class="form-group">
                                                                <label>Name *</label>
                                                                <input name="UserName" type="text" class="form-control" value="@User.Identity.Name" required />
                                                            </div>

                                                            <div class="form-group">
                                                                <label>Email *</label>
                                                                <input name="UserEmail" type="email" class="form-control" required />
                                                            </div>

                                                            <div class="form-group">
                                                                <label>Your Review *</label>
                                                                <textarea name="Comment" class="form-control" rows="5" required minlength="3" maxlength="2000"></textarea>
                                                            </div>

                                                            @* <button type="submit" class="btn ">Submit Review</button> *@
                                                            <div class="form-group full-width">
                                                                <input name="submit" type="submit" id="submit" class=" button-outline" value="Post Comment">
                                                            </div>
                                                        </form>

                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<style>
    /* Product Image Slider Styles - Updated */
    .product-images {
        position: relative;
    }

    /* Thumbnail Container */
    .thumbnail-container {
        position: relative;
        height: 400px;
        display: flex;
        flex-direction: column;
    }

    .thumbnail-scroll-btn {
        background: #fff;
        border: 1px solid #ddd;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 10;
    }

        .thumbnail-scroll-btn:hover:not(:disabled) {
            background: #f5f5f5;
            border-color: #999;
        }

        .thumbnail-scroll-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .thumbnail-wrapper {
        flex: 1;
        overflow: hidden;
        margin: 10px 0;
    }

    .thumbnail-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform 0.3s ease;
    }

    /* Updated thumbnail styles - removed blue border */
    .thumbnail-item {
        width: 70px;
        height: 70px;
        border: 2px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f9f9f9;
    }

        .thumbnail-item:hover {
            border-color: #999;
            transform: scale(1.05);
        }

        /* Removed blue border - now uses gray */
        .thumbnail-item.active {
            border-color: #666;
            box-shadow: 0 0 0 2px rgba(102, 102, 102, 0.2);
        }

        .thumbnail-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Hide the old slick elements */
    .img-item.slick-slide {
        display: none;
    }

    /* Main Image Container */
    .main-image-container {
        position: relative;
    }

    .main-image-wrapper {
        position: relative;
        background: #f9f9f9;
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 1;
    }

    #mainProductImage {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 0.3s ease;
    }

    /* Navigation Arrows */
    .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #ddd;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        transition: all 0.3s ease;
        z-index: 10;
    }

    .main-image-wrapper:hover .nav-arrow {
        opacity: 1;
    }

    .nav-arrow:hover {
        background: #fff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .prev-arrow {
        left: 15px;
    }

    .next-arrow {
        right: 15px;
    }

    /* Image Counter */
    .image-counter {
        position: absolute;
        bottom: 15px;
        right: 15px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
    }

    /* Mobile Responsive */
    media (max-width: 768px) {
        .thumbnail-container

    {
        height: auto;
        flex-direction: row;
        margin-bottom: 15px;
    }

    .thumbnail-scroll-btn {
