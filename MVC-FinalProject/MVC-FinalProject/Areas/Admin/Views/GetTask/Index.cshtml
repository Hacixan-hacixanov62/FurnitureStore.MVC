@model List<TaskVM>

@* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
 *@
<div class="main-panel">
    <div class="content-wrapper" style="width: 65pc;">
        <div class="col-md-12 col-xl-4 grid-margin stretch-card">
            <div class="card">
                <div class="card-body bg-dark text-white">
                    <h4 class="card-title">To Do List</h4>
                    <div class="list-wrapper"> 
                       <ul class="d-flex flex-column-reverse todo-list"> 
                            @foreach (var task in Model)
                            {
                                var completedClass = task.IsCompleted ? "completed text-decoration-line-through" : "";
                                <li class="task-item">
                                    <input type="checkbox" class="form-check-input me-2 checkbox-seen" />
                                    <span class="fw-bold task-title"
                                          data-task-id="@task.Id"
                                          data-task-title="@task.Title"
                                          data-task-desc="@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(task.Description ?? ""))"
                                          data-task-completed="@(task.IsCompleted.ToString().ToLower())"
                                          style="cursor:pointer;">
                                        @task.Title
                                    </span>
                                </li>
                            }
                         </ul> 
                     </div> 
                </div>
            </div>
        </div>
    </div>
</div>  

<div class="modal fade" id="taskDetailModal" tabindex="-1" aria-labelledby="taskDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title" id="taskDetailModalLabel">Task Detail</h5>
                <button type="button" class="btn-close bg-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h6 id="modalTaskTitle"></h6>
                <p id="modalTaskDescription" class="text-muted" style="color: white !important;"></p>
                <input type="hidden" id="modalTaskId" />
                <input type="hidden" id="modalCompletedBy" value="@User.Identity.Name" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" id="finishTaskBtn">Finish</button>
            </div>
        </div>
    </div>
</div>




  @section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("taskDetailModal");

            modal.addEventListener("show.bs.modal", function (event) {
                const trigger = event.relatedTarget;

                const taskId = trigger.getAttribute("data-task-id");
                const taskTitle = trigger.getAttribute("data-task-title");
                const taskDesc = trigger.getAttribute("data-task-desc");

                document.getElementById("modalTaskId").value = taskId;
                document.getElementById("modalTaskTitle").textContent = taskTitle;
                document.getElementById("modalTaskDescription").textContent = taskDesc;

                document.getElementById("taskDetailModal").setAttribute("data-li-id", taskId);
            });

            document.getElementById("finishTaskBtn").addEventListener("click", async function () {
                const taskId = parseInt(document.getElementById("modalTaskId").value);
                const completedBy = document.getElementById("modalCompletedBy").value;

                const response = await fetch("/Admin/GetTask/Complete", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        TaskId: taskId,
                        CompletedBy: completedBy
                    })
                });

                if (response.ok) {
                    const modalElement = bootstrap.Modal.getInstance(document.getElementById("taskDetailModal"));
                    modalElement.hide();

                    const allLi = document.querySelectorAll(`li`);
                    allLi.forEach(li => {
                        if (li.innerHTML.includes(`data-task-id="${taskId}"`)) {
                            li.classList.add("completed");

                            const oldIcon = li.querySelector(".finish-task");
                            if (oldIcon) {
                                oldIcon.remove();
                                const checkIcon = document.createElement("i");
                                checkIcon.className = "fa-solid fa-check";
                                checkIcon.style.marginLeft = "2pc";
                                li.appendChild(checkIcon);
                            }
                        }
                    });

                } else {
                    const errorText = await response.text();
                    alert("Xəta baş verdi: " + errorText);
                }
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("taskDetailModal");

            modal.addEventListener("show.bs.modal", function (event) {
                const trigger = event.relatedTarget;

                const taskId = trigger.getAttribute("data-task-id");
                const taskTitle = trigger.getAttribute("data-task-title");
                const taskDesc = trigger.getAttribute("data-task-desc");

                document.getElementById("modalTaskId").value = taskId;
                document.getElementById("modalTaskTitle").textContent = taskTitle;
                document.getElementById("modalTaskDescription").textContent = taskDesc;
            });

            document.getElementById("finishTaskBtn").addEventListener("click", function () {
                const taskId = document.getElementById("modalTaskId").value;
                const completedBy = document.getElementById("modalCompletedBy").value;            
            });
        });
    </script>
  <script>
           document.querySelectorAll(".checkbox-seen").forEach(checkbox => {
           checkbox.addEventListener("change", function() {
               if (this.checked) {
                   const li = this.closest("li");
                   const taskId = li.querySelector(".task-title").getAttribute("data-task-id");
                   const seenBy = document.getElementById("modalCompletedBy").value;

                      fetch(`/Admin/GetTask/MarkTaskAsSeen?id=${taskId}`, {
                       method: "POST",
                       headers: { "Content-Type": "application/json" },
                       body: JSON.stringify({ TaskId: parseInt(taskId), SeenBy: seenBy })
                   })
                   .then(response => {
                       if (!response.ok) {
                           alert("Failed to notify SuperAdmin.");
                           this.checked = false; 
                       } else {
                           this.disabled = true;
                       }
                   })
                   .catch(() => {
                       alert("Network error while notifying SuperAdmin.");
                       this.checked = false; 
                   });
               }
               });
           });

                document.querySelectorAll(".task-title").forEach(title => {
            title.addEventListener("click", function (e) {
                const li = this.closest("li");
                const checkbox = li.querySelector(".checkbox-seen");

                const isCompleted = this.getAttribute("data-task-completed")?.toLowerCase() === "true";

                if (!isCompleted && (!checkbox || !checkbox.checked)) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Attention!',
                        text: 'Please mark the task as seen before viewing details.',
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                const taskId = this.getAttribute("data-task-id");
                const taskTitle = this.getAttribute("data-task-title");
                const taskDesc = this.getAttribute("data-task-desc");

                document.getElementById("modalTaskId").value = taskId;
                document.getElementById("modalTaskTitle").textContent = taskTitle;
                document.getElementById("modalTaskDescription").textContent = taskDesc;

                const finishBtn = document.getElementById("finishTaskBtn");
                finishBtn.disabled = isCompleted;

                const modal = new bootstrap.Modal(document.getElementById("taskDetailModal"));
                modal.show();
            });
        });

                document.querySelectorAll(".task-title").forEach(title => {
            const li = title.closest("li");
            const isCompleted = title.getAttribute("data-task-completed")?.toLowerCase() === "true";

            if (isCompleted) {
                const checkbox = li.querySelector(".checkbox-seen");
                if (checkbox) {
                    checkbox.remove();
                }
            }
        });
    </script>
}  
