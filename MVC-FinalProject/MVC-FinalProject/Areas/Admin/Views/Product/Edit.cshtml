                function updateDeleteButtonsVisibility() {
            const images = document.querySelectorAll('[id^="image-"]');
            images.forEach(imgDiv => {
                const deleteBtn = imgDiv.querySelector("button");
                if (!deleteBtn) return;
                if (images.length === 1) {
                    deleteBtn.style.display = "none";
                } else {
                    deleteBtn.style.display = "inline-block";
                }
            });
        }

        function deleteImage(imageId) {
            const productId = document.getElementById("product-container")?.dataset.routeId;

            if (!productId) {
                console.error("Product ID not found!");
                return;
            }

            fetch(`/Admin/Product/DeleteImage?productId=${productId}&productImageId=${imageId}`, {
                method: "POST"
            })
            .then(async response => {
                if (!response.ok) {
                    const error = await response.json();
                    console.error("Error deleting image:", error.message);
                    return;
                }

                const deletedImageDiv = document.getElementById(`image-${imageId}`);
                if (!deletedImageDiv) return;

                const wasMain = deletedImageDiv.querySelector('input[type="radio"]').checked;

                deletedImageDiv.remove();

                if (wasMain) {
                    const remainingRadios = document.querySelectorAll('#product-container input[type="radio"]');
                    if (remainingRadios.length > 0) {
                        remainingRadios[0].checked = true;
                    }
                }

                updateDeleteButtonsVisibility();
            })
            .catch(error => {
                console.error("Error:", error);
            });
        }

        // Səhifə yüklənəndə bir dəfə çağır
        document.addEventListener("DOMContentLoaded", function() {
            updateDeleteButtonsVisibility();
        });

    </script>
