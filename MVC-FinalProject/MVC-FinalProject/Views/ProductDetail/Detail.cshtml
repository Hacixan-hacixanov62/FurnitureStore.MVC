                position: relative;
            }

            .color-swatches input[type="radio"] {
                display: none;
            }

            .color-swatches label {
                display: block;
                width: 30px;
                height: 30px;
                border-radius: 50%;
                border: 2px solid #ccc;
                cursor: pointer;
                transition: border 0.3s ease;
            }

