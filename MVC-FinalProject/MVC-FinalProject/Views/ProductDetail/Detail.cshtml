    }

    .image-counter {
        bottom: 10px;
        right: 10px;
        padding: 4px 8px;
        font-size: 12px;
    }

    }
</style>
<script>
     // Updated Product Image Slider JavaScript
    class ProductImageSlider {
      constructor() {
        this.currentIndex = 0
        this.thumbnailStartIndex = 0
        this.thumbnailsVisible = 4
        this.images = []
        this.init()
      }

      init() {
        this.collectImages()
        this.bindEvents()
        this.setInitialImage()
        this.updateDisplay()
        this.updateThumbnailScroll()
      }

      collectImages() {
        const thumbnails = document.querySelectorAll(".thumbnail-item")
        thumbnails.forEach((thumb, index) => {
          const img = thumb.querySelector("img")
          this.images.push({
            src: img.src,
            alt: img.alt || `Product Image ${index + 1}`,
          })
        })

        // Update total images count
        const totalImagesElement = document.getElementById("totalImages")
        if (totalImagesElement) {
          totalImagesElement.textContent = this.images.length
        }
      }

      setInitialImage() {
        // Check if there's a main image set in the HTML
        const mainImg = document.getElementById("mainProductImage")
        if (mainImg && mainImg.src) {
          // Find the index of the main image in our images array
          const mainImageIndex = this.images.findIndex((img) => img.src === mainImg.src)
          if (mainImageIndex !== -1) {
            this.currentIndex = mainImageIndex
          }
        }
      }

      bindEvents() {
        // Thumbnail clicks
        document.querySelectorAll(".thumbnail-item").forEach((thumb, index) => {
          thumb.addEventListener("click", (e) => {
            e.preventDefault()
            this.goToImage(index)
          })
        })

        // Navigation arrows
        const prevArrow = document.getElementById("prevArrow")
        const nextArrow = document.getElementById("nextArrow")

        if (prevArrow) {
          prevArrow.addEventListener("click", () => {
            this.previousImage()
          })
        }

        if (nextArrow) {
          nextArrow.addEventListener("click", () => {
            this.nextImage()
          })
        }

        // Thumbnail scroll buttons
        const scrollUp = document.getElementById("scrollUp")
        const scrollDown = document.getElementById("scrollDown")

        if (scrollUp) {
          scrollUp.addEventListener("click", () => {
            this.scrollThumbnailsUp()
          })
        }

        if (scrollDown) {
          scrollDown.addEventListener("click", () => {
            this.scrollThumbnailsDown()
          })
        }

        // Keyboard navigation
        document.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") {
            this.previousImage()
          } else if (e.key === "ArrowRight") {
            this.nextImage()
          }
        })

        // Touch/swipe support for mobile
        let startX = 0
        let endX = 0

        const mainImage = document.getElementById("mainProductImage")
        if (mainImage) {
          mainImage.addEventListener("touchstart", (e) => {
            startX = e.touches[0].clientX
          })

          mainImage.addEventListener("touchend", (e) => {
            endX = e.changedTouches[0].clientX
            this.handleSwipe(startX, endX)
          })
        }
      }

      handleSwipe(startX, endX) {
        const threshold = 50
        const diff = startX - endX

        if (Math.abs(diff) > threshold) {
          if (diff > 0) {
            this.nextImage()
          } else {
            this.previousImage()
          }
        }
      }

      goToImage(index) {
        if (index >= 0 && index < this.images.length) {
          this.currentIndex = index
          this.updateDisplay()
          this.ensureThumbnailVisible(index)
        }
      }

      nextImage() {
        const nextIndex = (this.currentIndex + 1) % this.images.length
        this.goToImage(nextIndex)
      }

      previousImage() {
        const prevIndex = this.currentIndex === 0 ? this.images.length - 1 : this.currentIndex - 1
        this.goToImage(prevIndex)
      }

      updateDisplay() {
        // Update main image
        const mainImg = document.getElementById("mainProductImage")
        if (mainImg && this.images[this.currentIndex]) {
          mainImg.src = this.images[this.currentIndex].src
          mainImg.alt = this.images[this.currentIndex].alt
        }

        // Update image counter
        const currentImageNum = document.getElementById("currentImageNum")
        if (currentImageNum) {
          currentImageNum.textContent = this.currentIndex + 1
        }

        // Update active thumbnail
        document.querySelectorAll(".thumbnail-item").forEach((thumb, index) => {
          if (index === this.currentIndex) {
            thumb.classList.add("active")
          } else {
            thumb.classList.remove("active")
          }
        })
      }

      ensureThumbnailVisible(index) {
        if (window.innerWidth > 768) {
          // Desktop only
          if (index < this.thumbnailStartIndex) {
            this.thumbnailStartIndex = index
            this.updateThumbnailScroll()
          } else if (index >= this.thumbnailStartIndex + this.thumbnailsVisible) {
            this.thumbnailStartIndex = index - this.thumbnailsVisible + 1
            this.updateThumbnailScroll()
          }
        }
      }

      scrollThumbnailsUp() {
        if (this.thumbnailStartIndex > 0) {
          this.thumbnailStartIndex--
          this.updateThumbnailScroll()
        }
      }

      scrollThumbnailsDown() {
        if (this.thumbnailStartIndex < this.images.length - this.thumbnailsVisible) {
          this.thumbnailStartIndex++
          this.updateThumbnailScroll()
        }
      }

      updateThumbnailScroll() {
        if (window.innerWidth > 768) {
          // Desktop only
          const thumbnailList = document.getElementById("thumbnailList")
          if (thumbnailList) {
            const translateY = -this.thumbnailStartIndex * 80 // 70px height + 10px gap
            thumbnailList.style.transform = `translateY(${translateY}px)`
          }

          // Update scroll button states
          const scrollUp = document.getElementById("scrollUp")
          const scrollDown = document.getElementById("scrollDown")

          if (scrollUp) {
            scrollUp.disabled = this.thumbnailStartIndex === 0
          }

          if (scrollDown) {
            scrollDown.disabled = this.thumbnailStartIndex >= this.images.length - this.thumbnailsVisible
          }
        }
      }
    }

    // Initialize slider when DOM is loaded
    document.addEventListener("DOMContentLoaded", () => {
      new ProductImageSlider()
    })

    // Handle window resize
    window.addEventListener("resize", () => {
      // Reset thumbnail scroll on mobile/desktop switch
      const thumbnailList = document.getElementById("thumbnailList")
      if (thumbnailList && window.innerWidth <= 768) {
        thumbnailList.style.transform = "translateY(0)"
      }
    })

</script>















<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("addToBasketForm");
        const addToCartBtn = document.getElementById("addToCartBtn");

        const colorInputs = document.querySelectorAll('input[name="colorId"]');
        colorInputs.forEach(input => {
            input.addEventListener("change", () => {
                addToCartBtn.disabled = false;
            });
        });

        form.addEventListener("submit", function (e) {
            e.preventDefault();

            const formData = new FormData(form);
            const data = new URLSearchParams(formData);

            fetch("/Basket/AddToBasket", {
                method: "POST",
                body: data,
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
            .then(res => {
                if (res.status === 401) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Please login',
                        text: 'You need to login to add product to cart',
                        confirmButtonText: 'Login now'
                    }).then(() => {
                        window.location.href = "/Account/Login";
                    });
                    return;
                }

                return res.json();
            })
            .then(response => {
                if (!response) return;

                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Added to cart',
                        text: response.message || 'Product successfully added to your basket!',
                        timer: 2000,
                        showConfirmButton: false
                    });

                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: response.message || 'Failed to add product to cart.'
                    });
                }
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Something went wrong!',
                });
            });
        });
    });
</script>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/assets/js/product-detail.js"></script>
}